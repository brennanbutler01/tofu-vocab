generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model Flashcard {
  id         String           @id @default(uuid())
  created_at DateTime         @default(now()) @db.Timestamptz(3)
  updated_at DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  userId     String
  boxId      String
  front      String[]
  back       String[]
  origin     FlashcardOrigins @default(USER)
  box        LeitnerBox       @relation(fields: [boxId], references: [id])
  createdBy  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts   StudyAttempt[]
}

model GroupFlashcard {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  groupId    String
  front      String[]
  back       String[]
  studyGroup StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model StudyAttempt {
  id          String     @id @default(uuid())
  created_at  DateTime   @default(now()) @db.Timestamptz(3)
  updated_at  DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  userId      String
  flashcardId String?
  isCorrect   Boolean
  flashcard   Flashcard? @relation(fields: [flashcardId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeitnerBox {
  id         String      @id @default(uuid())
  created_at DateTime    @default(now()) @db.Timestamptz(3)
  updated_at DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  userId     String
  boxNumber  Int
  flashcards Flashcard[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, boxNumber])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyGroup {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  allowJoin   Boolean          @default(false)
  name        String
  description String
  ownerId     String
  image       String?
  flashcards  GroupFlashcard[]
  owner       User             @relation("owner", fields: [ownerId], references: [id])
  users       User[]           @relation("users")
  invitations Invitation[]
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  learningLanguage Languages        @default(VIETNAMESE)
  nativeLanguage   Languages        @default(ENGLISH)
  studySide        StudySides       @default(FRONT)
  created_at       DateTime?        @default(now()) @db.Timestamptz(3)
  bestStreak       Int              @default(0)
  currentStreak    Int              @default(0)
  flashcardSource  FlashcardSources @default(ALL)
  timeZone         String           @default("America/Los_Angeles")
  demoVisit        DemoVisit?
  accounts         Account[]
  flashcards       Flashcard[]
  receivedInvites  Invitation[]     @relation("recipient")
  sentInvites      Invitation[]     @relation("sentBy")
  boxes            LeitnerBox[]
  sessions         Session[]
  attempts         StudyAttempt[]
  owner            StudyGroup[]     @relation("owner")
  groups           StudyGroup[]     @relation("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id          String           @id
  sentById    String
  dateSent    DateTime         @default(now())
  recipientId String
  status      InvitationStatus
  recipient   User             @relation("recipient", fields: [recipientId], references: [id])
  sentBy      User             @relation("sentBy", fields: [sentById], references: [id])
  group       StudyGroup       @relation(fields: [groupId], references: [id])
  groupId     String
}

enum FlashcardOrigins {
  USER
  GROUP
  RANDOM_WORD
}

enum Languages {
  VIETNAMESE
  ENGLISH
}

enum StudySides {
  FRONT
  BACK
}

enum FlashcardSources {
  ALL
  BOX4
  NOT_STUDIED
  IN_PROGRESS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DENIED
}

model DemoVisit {
  userId String @id
  expiresAt DateTime @db.Timestamptz(3)
  requests Int @default(0)
  writeBytes Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
