{
	"private": true,
	"scripts": {
		"dev": "next dev --webpack",
		"build": "next build --webpack",
		"start": "next start",
		"test": "jest --watch --i",
		"lint": "eslint",
		"e2e": "playwright test",
		"format": "prettier . --w",
		"postinstall": "prisma generate",
		"test:ci": "jest --runInBand",
		"test:browser": "playwright test --config=playwright.local.config.ts",
		"typecheck": "tsc --noEmit",
		"local:setup": "python3 scripts/setup-local.py",
		"build:portfolio": "next build portfolio-site --webpack",
		"test:portfolio": "playwright test --config=playwright.portfolio.config.ts",
		"deploy:portfolio": "yarn build:portfolio && yarn test:portfolio && python3 scripts/deploy_portfolio.py",
		"test:visitor": "playwright test --config=playwright.visitor.config.ts",
		"deploy:visitor": "python3 scripts/deploy_visitor.py"
	},
	"dependencies": {
		"@emotion/react": "^11.10.5",
		"@emotion/server": "^11.10.0",
		"@mantine/core": "^6.0.16",
		"@mantine/dates": "^6.0.16",
		"@mantine/form": "^6.0.16",
		"@mantine/hooks": "^6.0.16",
		"@mantine/modals": "^6.0.16",
		"@mantine/next": "^6.0.16",
		"@mantine/notifications": "^6.0.16",
		"@mantine/nprogress": "^6.0.16",
		"@next-auth/prisma-adapter": "^1.0.5",
		"@nivo/bar": "0.99.0",
		"@nivo/calendar": "0.99.0",
		"@nivo/colors": "0.99.0",
		"@nivo/core": "0.99.0",
		"@nivo/funnel": "0.99.0",
		"@nivo/line": "0.99.0",
		"@nivo/pie": "0.99.0",
		"@nivo/stream": "0.99.0",
		"@nivo/waffle": "0.99.0",
		"@prisma/client": "7.10.0",
		"@vitalets/google-translate-api": "^9.2.0",
		"cloudinary": "2.11.0",
		"dayjs": "^1.11.6",
		"formidable": "3.5.4",
		"http-proxy-agent": "^7.0.0",
		"next": "16.3.4",
		"next-auth": "4.24.15",
		"random-words": "^1.2.0",
		"react": "^18.2.0",
		"react-country-flag": "^3.0.2",
		"react-dom": "^18.2.0",
		"react-icons": "^4.10.1",
		"swr": "^2.0.0",
		"uuid": "11.1.1",
		"zod": "3.25.76",
		"@prisma/adapter-pg": "7.10.0"
	},
	"devDependencies": {
		"@playwright/test": "1.58.2",
		"@testing-library/jest-dom": "^5.16.5",
		"@testing-library/react": "^13.4.0",
		"@testing-library/user-event": "^14.4.3",
		"@types/formidable": "3.4.5",
		"@types/node": "18.6.3",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@types/streamifier": "^0.1.0",
		"@types/whatwg-fetch": "^0.0.33",
		"dotenv": "^16.0.3",
		"eslint": "^8.29.0",
		"jest": "30.5.1",
		"jest-mock-extended": "^3.0.1",
		"next-router-mock": "^0.8.0",
		"playwright": "1.58.2",
		"prettier": "^3.0.0",
		"prisma": "7.10.0",
		"ts-jest": "^29.0.3",
		"typescript": "5.9.3",
		"whatwg-fetch": "^3.6.2",
		"msw": "2.15.0",
		"@jest/environment-jsdom-abstract": "30.5.1",
		"jsdom": "29.1.1"
	},
	"msw": {
		"workerDirectory": "public"
	},
	"prettier": {
		"arrowParens": "avoid",
		"tabWidth": 4,
		"useTabs": true,
		"singleQuote": true,
		"singleAttributePerLine": true
	},
	"postInstall": "prisma generate",
	"packageManager": "yarn@1.22.22",
	"engines": {
		"node": ">=24.13.0 <25"
	}
}
